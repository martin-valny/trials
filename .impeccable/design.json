      "html": "<div class=\"ds-yr\"><i class=\"ds-yr-bar\" style=\"left:20%;right:10%\"></i></div>",
      "css": ".ds-yr{position:relative;height:18px;width:15rem}.ds-yr::before{content:'';position:absolute;left:5px;right:5px;top:50%;height:1px;background:var(--rule,#d6dadd)}.ds-yr-bar{position:absolute;top:50%;height:2px;margin-top:-1px;background:var(--ink,#111)}"
