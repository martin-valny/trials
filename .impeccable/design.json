      "kind": "chip",
      "refersTo": "dropdown-rest",
      "description": "Toolbar filter: hairline border and muted value at rest; ink border and 700 value once it narrows. Opens a flat plate inset with an ink top edge; a 44dvh bottom sheet with a 1px ink top rule on phones, scrolling the map into view above it.",
      "html": "<button class=\"ds-dd\" data-narrowed=\"false\">Phase: <span class=\"ds-v\">all</span></button> <button class=\"ds-dd\" data-narrowed=\"true\">Disease: <span class=\"ds-v\">2 of 6</span></button>",
      "css": ".ds-dd{font:inherit;font-size:12.5px;color:var(--ink,#111);background:var(--plate,#fff);border:1px solid var(--rule,#d6dadd);border-radius:999px;padding:4px 10px;cursor:pointer;font-variant-numeric:tabular-nums}.ds-dd .ds-v{color:var(--muted,#5b6268)}.ds-dd[data-narrowed=true]{border-color:var(--ink,#111)}.ds-dd[data-narrowed=true] .ds-v{color:var(--ink,#111);font-weight:700}.ds-dd:hover{border-color:var(--ink,#111)}.ds-dd:focus-visible{outline:2px solid var(--ink,#111);outline-offset:2px}"
    },
