      "css": ".ds-pill{font:inherit;font-size:12.5px;color:var(--ink,#111);background:var(--plate,#fff);border:1px solid var(--muted,#5b6268);border-radius:999px;padding:4px 10px;cursor:pointer}.ds-pill:hover{border-color:var(--ink,#111)}.ds-pill[aria-pressed=true]{background:var(--ink,#111);color:var(--plate,#fff);border-color:var(--ink,#111)}.ds-pill:focus-visible{outline:2px solid var(--ink,#111);outline-offset:2px}"
