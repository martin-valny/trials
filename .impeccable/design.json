      "kind": "custom",
      "refersTo": "",
      "description": "Panel b bar with average tick.",
      "html": "<div class=\"ds-bar\"><span>Disease</span><div class=\"ds-track\"><i class=\"ds-fill\" style=\"width:60%\"></i><i class=\"ds-avg\" style=\"left:45%\"></i></div></div>",
      "css": ".ds-bar{display:grid;grid-template-columns:8rem 1fr;gap:8px;align-items:center;font-size:13px;color:var(--ink,#111)}.ds-track{position:relative;height:12px;background:var(--pale,#e4e8eb)}.ds-fill{position:absolute;inset:0 auto 0 0;background:var(--ink,#111)}.ds-avg{position:absolute;top:-3px;bottom:-3px;width:2px;margin-left:-1px;background:var(--ink,#111);box-shadow:0 0 0 1px var(--plate,#fff)}"
    },
    {
