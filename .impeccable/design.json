  "narrative": {
    "northStar": "The Figure Plate",
    "overview": "The Explore page is Figure 1 of a paper: a flat white plate with lettered panels a-d, a toolbar set as the figure's legend line above it, a one-line figure key under panel a's heading, panel d under an ink rule, hairline rules, Hanken Grotesk only, and one red reserved for succeeded trials. Dark mode (a manual System/Light/Dark choice in the header) is a Dark slide with orange in red's place. Governs the Explore route only; other routes are not yet restyled.",
    "keyCharacteristics": [
      "White plate, near-black ink, hairline rules; flat",
      "Red means succeeded and nothing else",
      "Bold lowercase panel letters a-d",
      "Pills for all controls, in one toolbar above the plate",
      "Canvas starts still; Play turns it slowly"
    ],
    "rules": [
      {
        "name": "The Only-Succeeded Rule",
        "body": "Red is used only for succeeded data. Never for focus rings, ticks, links, selection, errors or category colours.",
        "section": "colors"
      },
      {
        "name": "The Shape-Not-Shade Rule",
        "body": "Unknown outcome is a hollow 1px ring, distinguished by shape.",
        "section": "colors"
      },
      {
        "name": "The Lowercase Letter Rule",
        "body": "Panels are labelled with bold lowercase letters only.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do letter panels with bold lowercase a, b, c, d at 22px/800.",
      "Do separate regions with 1px rules: ink above panel d, hairline under the toolbar and elsewhere.",
      "Do keep controls as pills: solid ink when chosen or narrowing; hairline and muted value at rest; ink border and 700 value when a dropdown narrows.",
      "Do size dots by capped square-root enrollment and encode unknown by ring shape.",
      "Do honour both schemes via tokens."
    ],
    "donts": [
      "Don't use red (or dark-mode orange) for anything but succeeded data.",
      "Don't add shadows, glows, gradients or card chrome to panels.",
      "Don't reorder the layout into filters-left / canvas-centre / details-right.",
      "Don't claim the rest of the site follows this system."
    ]
  }
